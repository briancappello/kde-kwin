+namespace {
+// Format an id verbatim, with length annotation so we can tell apart
+// "" / "Desktop" / "{uuid}" / etc.
+inline QString vdbg_fmtId(const QString &s)
+{
+    return QStringLiteral("<") + s + QStringLiteral(">|len=") + QString::number(s.size());
+}
+inline QString vdbg_fmtList(const QStringList &l)
+{
+    QStringList out;
+    out.reserve(l.size());
+    for (int i = 0; i < l.size(); ++i) {
+        out << QStringLiteral("[%1]=").arg(i) + vdbg_fmtId(l.at(i));
+    }
+    return QStringLiteral("(count=") + QString::number(l.size()) + QStringLiteral(") {")
+         + out.join(QStringLiteral(", ")) + QLatin1Char('}');
+}
+// Iterate the hash itself (NOT just the order list), so duplicates in the
+// order list do not produce phantom duplicate hash entries in the output.
+inline QString vdbg_fmtHash(const QHash<QString, QString> &h)
+{
+    QStringList parts;
+    parts.reserve(h.size());
+    for (auto it = h.constBegin(); it != h.constEnd(); ++it) {
+        parts << vdbg_fmtId(it.key()) + QStringLiteral(" => \"") + it.value() + QStringLiteral("\"");
+    }
+    return QStringLiteral("(size=") + QString::number(h.size()) + QStringLiteral(") {")
+         + parts.join(QStringLiteral(", ")) + QLatin1Char('}');
+}
+} // namespace
