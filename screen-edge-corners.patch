+/**
+ * Compute the convex (outward-pointing) corners of the outer perimeter formed
+ * by the union of all output geometries.
+ *
+ * The Region class decomposes the union into horizontal bands of non-overlapping
+ * rectangles sorted in y-x order.  By walking the bands top-to-bottom and
+ * comparing the left/right extents of adjacent bands we can identify every
+ * vertex where the perimeter turns outward -- these are the points where the
+ * mouse cursor can get trapped against two edges simultaneously.
+ */
+static std::vector<PerimeterCorner> findPerimeterCorners(const QList<LogicalOutput *> &outputs)
+{
+    if (outputs.isEmpty()) {
+        return {};
+    }
+
+    // Build the union region of all outputs.
+    Region displayRegion;
+    for (const LogicalOutput *output : outputs) {
+        displayRegion += output->geometry();
+    }
+
+    const auto rects = displayRegion.rects();
+    if (rects.empty()) {
+        return {};
+    }
+
+    // Group rects into horizontal bands.  Each band is a set of rects sharing
+    // the same top and bottom (y and height).  We store the leftmost x and
+    // rightmost x+width for each band.
+    struct Band
+    {
+        int top;
+        int bottom;
+        int left;   // leftmost x of any rect in the band
+        int right;  // rightmost x+width of any rect in the band
+    };
+    std::vector<Band> bands;
+
+    for (const Rect &r : rects) {
+        if (!bands.empty() && bands.back().top == r.y() && bands.back().bottom == r.bottom()) {
+            // Same band -- extend extents.
+            bands.back().left = std::min(bands.back().left, r.x());
+            bands.back().right = std::max(bands.back().right, r.right());
+        } else {
+            bands.push_back({r.y(), r.bottom(), r.x(), r.right()});
+        }
+    }
+
+    std::vector<PerimeterCorner> corners;
+
+    // First band: top-left and top-right corners of the overall display.
+    corners.push_back({ElectricTopLeft, bands.front().left, bands.front().top});
+    corners.push_back({ElectricTopRight, bands.front().right, bands.front().top});
+
+    // Walk adjacent bands and find convex corners at each transition.
+    for (size_t i = 0; i + 1 < bands.size(); ++i) {
+        const Band &upper = bands[i];
+        const Band &lower = bands[i + 1];
+
+        // Left side: compare left extents.
+        if (lower.left > upper.left) {
+            // Lower band is narrower on the left -- the upper band's left side
+            // sticks out, creating a BottomLeft corner on the upper band.
+            corners.push_back({ElectricBottomLeft, upper.left, upper.bottom});
+        } else if (lower.left < upper.left) {
+            // Lower band is wider on the left -- the lower band's left side
+            // sticks out, creating a TopLeft corner on the lower band.
+            corners.push_back({ElectricTopLeft, lower.left, lower.top});
+        }
+
+        // Right side: compare right extents.
+        if (lower.right < upper.right) {
+            // Lower band is narrower on the right -- the upper band's right side
+            // sticks out, creating a BottomRight corner on the upper band.
+            corners.push_back({ElectricBottomRight, upper.right, upper.bottom});
+        } else if (lower.right > upper.right) {
+            // Lower band is wider on the right -- the lower band's right side
+            // sticks out, creating a TopRight corner on the lower band.
+            corners.push_back({ElectricTopRight, lower.right, lower.top});
+        }
+    }
+
+    // Last band: bottom-left and bottom-right corners of the overall display.
+    corners.push_back({ElectricBottomLeft, bands.back().left, bands.back().bottom});
+    corners.push_back({ElectricBottomRight, bands.back().right, bands.back().bottom});
+
+    return corners;
+}
+
+/**
+ * Check whether a corner position is in the set of perimeter corners.
+ * Used by edge creation to decide whether to inset an edge endpoint.
+ */
+static bool hasCornerAt(const std::vector<PerimeterCorner> &corners, int x, int y)
+{
+    for (const auto &c : corners) {
+        if (c.x == x && c.y == y) {
+            return true;
+        }
+    }
+    return false;
+}
