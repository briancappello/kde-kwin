+// Returns true iff `id` looks like a valid UUID as produced by
+// QUuid::createUuid().toString(QUuid::WithoutBraces): a non-null UUID
+// when parsed, AND its canonical form (without braces) round-trips to
+// the same string. Catches both the empty case and legacy values like
+// the literal string "Desktop" that older Plasma versions persisted.
+static bool isWellFormedDesktopId(const QString &id)
+{
+    if (id.isEmpty()) {
+        return false;
+    }
+    const QUuid parsed = QUuid::fromString(id);
+    if (parsed.isNull()) {
+        return false;
+    }
+    return parsed.toString(QUuid::WithoutBraces) == id;
+}
