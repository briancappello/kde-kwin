groups=(plasma)
source=(https://download.kde.org/stable/plasma/$_dirver/$pkgname-$pkgver.tar.xz{,.sig}
        # --- local overlay patches (kde-kwin repo) ---
        swap-gesture-fingers.patch
        screen-edge-corners.patch
        virtual-desktops-debug.patch
        virtual-desktops-fix.patch)
sha256sums=('352bfb34efad1435071960ef4cd392b110a18e1c168d1fdc5cce6b43331d0875'
